# % VRAM tối đa node này được cấp trên GPU dùng chung (host 4GB, chia sẻ với
# reup-transcribe-node/reup-tts-gpu-node qua khoá GPU Redis, xem README).
GPU_MEMORY_FRACTION=0.3

# Ngôn ngữ OCR mặc định (route detect+recognize trong ocr_engine.py). vi = PaddleOCR detect +
# VietOCR recognize; en/fr = PaddleOCR detect+recognize gốc.
OCR_LANG=vi

# vgg_transformer = độ chính xác cao hơn, vgg_seq2seq = nhanh hơn.
VIETOCR_MODEL_NAME=vgg_transformer
VIETOCR_DEVICE=cuda:0
